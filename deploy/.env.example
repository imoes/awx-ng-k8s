# awx-ng deploy/.env — Kopiere nach .env und passe Werte an
# docker-compose liest .env automatisch aus dem deploy/-Verzeichnis

# ── AWX Admin-Login ──────────────────────────────────────────────────────────
# Wird beim ersten Start gesetzt (danach nur noch über UI änderbar)
AWX_ADMIN_PASSWORD=changeme123!

# ── Ansible-Repo ─────────────────────────────────────────────────────────────
# Pfad zum lokalen ansible-Repo (wird in awx_task/ee gemountet)
ANSIBLE_REPO_PATH=/home/mutkluge/Dev/ansible/ansible03

# ── NetBox-Integration ────────────────────────────────────────────────────────
NETBOX_URL=https://netbox.ippen.media
NETBOX_TOKEN=<dein-netbox-api-token>

# ── OIDC/SSO (alle drei setzen oder alle drei leer lassen) ───────────────────
# Provider: Keycloak / Entra-ID / Authentik etc.
# Endpoint: URL bis vor /.well-known/openid-configuration
OIDC_KEY=
OIDC_SECRET=
OIDC_ENDPOINT=
OIDC_VERIFY_SSL=true
